# Model — Google Gemini (FREE tier). Get a key at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the model id (defaults to gemini-3.8-flash, which is free)
GOOGLE_MODEL=gemini-3.8-flash

# Web search — Tavily (FREE tier, ~1,000 credits/mo). Get a key at https://tavily.com
TAVILY_API_KEY=

# Optional: where the SQLite database file lives (defaults to data/chat.db)
# DATABASE_PATH=data/chat.db
