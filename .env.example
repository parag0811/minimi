# Model — Google Gemini (FREE tier). Get a key at https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the model id. gemini-3.5-flash-lite is the FAST free default
# (~5s). Use gemini-3.6-flash for higher quality (slower, ~25-30s on the free tier).
GOOGLE_MODEL=gemini-3.5-flash-lite

# Web search — Tavily (FREE tier, ~1,000 credits/mo). Get a key at https://tavily.com
TAVILY_API_KEY=
